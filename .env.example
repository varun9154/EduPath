# ============================================================
# EDUPATH PRODUCTION ENVIRONMENT
# ============================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Authentication
ADMIN_EMAIL=edupathadmin@gmail.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET

# ============================================================
# EXCEL STORAGE
# ============================================================
# Excel remains the application's data format.
# In Vercel production, store the workbook in a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
EDUPATH_EXCEL_BLOB_PATH=edupath/edupath.xlsx

# ============================================================
# EMAIL
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduPath AI <noreply@edupath.in>"

# ============================================================
# WHATSAPP / SMS
# ============================================================
ADMIN_PHONE=+91XXXXXXXXXX
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional AI integration
AI_API_KEY=
