# ============================================================
# EDUPATH PRODUCTION ENVIRONMENT
# ============================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Authentication
ADMIN_EMAIL=edupathadmin@gmail.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET

# ============================================================
# PRIMARY PRODUCTION DATABASE
# ============================================================
# Neon PostgreSQL is the source of truth for registrations, students,
# demo bookings, leads, counselling and admin operational records.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME

# ============================================================
# EXCEL STORAGE / REPORTING
# ============================================================
# Excel is retained for admin exports/reporting and legacy course-progress data.
# In Vercel production, use a PRIVATE Vercel Blob store so /tmp is never treated
# as durable storage.
BLOB_READ_WRITE_TOKEN=
EDUPATH_EXCEL_BLOB_PATH=edupath/edupath.xlsx

# ============================================================
# EMAIL
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduPath AI <noreply@edupath.in>"

# ============================================================
# WHATSAPP / SMS
# ============================================================
ADMIN_PHONE=+91XXXXXXXXXX
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional AI integration
AI_API_KEY=

# ============================================================
# PRODUCTION CHECKLIST
# ============================================================
# Vercel Production MUST have:
# 1. DATABASE_URL connected to the production Neon/Postgres database
# 2. BLOB_READ_WRITE_TOKEN from a private Vercel Blob store
# 3. AUTH_SECRET (32+ random characters)
# 4. ADMIN_PASSWORD
# 5. SMTP credentials for student/admin email
# 6. WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID for WhatsApp Cloud API
#
# Never commit a real .env file or secrets to GitHub.

# ============================================================
# MULTI-LLM AI COUNSELLOR
# ============================================================
# Configure 1 primary + as many fallbacks as desired. The route
# tries them in this order and falls back automatically if one fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_TIMEOUT_MS=12000
